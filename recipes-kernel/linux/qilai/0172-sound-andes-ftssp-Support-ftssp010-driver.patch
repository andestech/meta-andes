+
+void fill_codec_reg(void)
+{
+	int sai = 0;
+
+	alc5640_write_codec(0x1, 0x0808, sai); //
+	alc5640_write_codec(0x2, 0x0808, sai); //
+	alc5640_write_codec(0x3, 0x0808, sai); //
+
+	alc5640_write_codec(0x19, 0x8080, sai); //
+	alc5640_write_codec(0x1A, 0x8080, sai); //
+	alc5640_write_codec(0x3C, 0x007D, sai); // BST1 to RECMIXL
+	alc5640_write_codec(0x3E, 0x007D, sai); // BST1 to RECMIXR
+	alc5640_write_codec(0x27, 0x3020, sai); // ADCL&R Path
+	alc5640_write_codec(0x2A, 0x1414, sai); // DACL1&DACR1 to Stereo_DAC_Mixer_L&R
+	alc5640_write_codec(0x1C, 0x5F5F, sai); // Digital Mic gain
+	alc5640_write_codec(0x29, 0x8080, sai); // I2S1 in or Mic path to DAC
+	alc5640_write_codec(0x4F, 0x01FE, sai); // DACL1 to OUTMIXL
+	alc5640_write_codec(0x52, 0x01FE, sai); // DACR1 to OUTMIXR
+	alc5640_write_codec(0x03, 0x0808, sai); // Lineout & OUTVOLL&R
+	alc5640_write_codec(0x53, 0xC000, sai); // OUTVOLL&R to LOUTMIX
+	// Power
+	alc5640_write_codec(0x61, 0x9807, sai); // I2S1, DACL/R1, ADCL/R1, D AMP
+	alc5640_write_codec(0x62, 0x8000, sai); // ADC filter
+	alc5640_write_codec(0x63, 0xF814, sai); // VREF1, VREF1 fast mode, MBIAS, LOUTMIX, VERF2, VERF2 fast mode
+	alc5640_write_codec(0x64, 0x8A00, sai); // MIC BST1, MICBIAS1, PLL
+	alc5640_write_codec(0x65, 0xCC00, sai); // RECMIXL/R, OUTMIXL/R
+	alc5640_write_codec(0x66, 0x3000, sai); // OUTVOL
+	// System Clock div
+	alc5640_write_codec(0x73, 0x0000, sai);
+	// PLL BCLK x8
+	alc5640_write_codec(0x80, 0x5000, sai); // PLL Source BCLK1
+	alc5640_write_codec(0x81, 0x1F06, sai); // N = 62 , K = 6
+	alc5640_write_codec(0x82, 0x0800, sai); // Bypass M
+	// Other
+	alc5640_write_codec(0x6A, 0x003D, sai); // PR-3D
+	alc5640_write_codec(0x6C, 0x3600, sai); // PR-3D ADC/DAC clock
+	alc5640_write_codec(0xFA, 0x7601, sai); // I2S1 Interface
+	alc5640_write_codec(0x8E, 0x0019, sai); // pow HP AMP , Charge Pump Power, Enable Headphone Output
+	alc5640_write_codec(0x8F, 0x3000, sai); // HP Depop Mode 2
+	alc5640_write_codec(0x91, 0x0E00, sai); // HP High voltage mode
+	alc5640_write_codec(0x93, 0x3030, sai);
+}
+EXPORT_SYMBOL(fill_codec_reg);
