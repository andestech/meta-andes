diff --git a/drivers/dma/atcdmac300g.c b/drivers/dma/atcdmac300g.c
index 7fa3bf22dc1f..2417c81ea562 100644
--- a/drivers/dma/atcdmac300g.c
+++ b/drivers/dma/atcdmac300g.c
@@ -162,6 +162,7 @@ static void v5_desc_put(struct v5_dma_chan *v5chan, struct v5_desc *desc)
 		dev_vdbg(chan2dev(&v5chan->chan_common),
 			 "moving desc %p to freelist\n", desc);
 		list_add(&desc->desc_node, &v5chan->free_list);
+
 		spin_unlock_irqrestore(&v5chan->lock, flags);
 	}
 }
@@ -188,6 +189,7 @@ static void v5_desc_chain(struct v5_desc **first, struct v5_desc **prev,
 
 		/* insert the descriptor to the ring */
 		list_add_tail(&desc->desc_node, &(*first)->tx_list);
+
 	}
 	*prev = desc;
 
@@ -909,8 +911,15 @@ static int v5_config(struct dma_chan *chan,
 
 static int v5_terminate_all(struct dma_chan *chan)
 {
-	struct v5_dma_chan	*v5chan = to_v5_dma_chan(chan);
+	struct v5_dma_chan *v5chan = to_v5_dma_chan(chan);
+	struct v5_desc *desc, *_desc;
+	struct v5_desc *cyclic_desc, *next_cyclic_desc;
+	struct v5_desc *first_desc;
 	LIST_HEAD(list);
+	struct list_head *desc_node;
+	int flags;
+	u16 index;
+
 
 	dev_vdbg(chan2dev(chan), "%s\n", __func__);
 	/*
@@ -925,11 +934,75 @@ static int v5_terminate_all(struct dma_chan *chan)
 	/* confirm that this channel is disabled */
 	while (v5_chan_is_enabled(v5chan))
 		cpu_relax();
+
+	spin_lock_irqsave(&v5chan->lock, flags);
+
+
 	/* active_list entries will end up before queued entries */
-	list_splice_init(&v5chan->queue, &v5chan->free_list);
-	list_splice_init(&v5chan->active_list, &v5chan->free_list);
+	if (!list_empty(&v5chan->queue)) {
+		list_for_each_entry_safe(desc, _desc, &v5chan->queue, desc_node) {
+
+			if (desc->cyclic == true) {
+				struct list_head *desc_node;
+				struct v5_desc *first_desc, *desc;
+				u16 index;
+
+				first_desc = desc;
+
+				desc_node = first_desc->tx_list.next;
+				list_del(&first_desc->desc_node);
+				list_add_tail(&first_desc->desc_node, &v5chan->free_list);
+
+				for (index = 1; index < first_desc->num_sg; index++) {
+					desc = list_entry(desc_node, struct v5_desc,
+						desc_node);
+
+					desc_node = desc->desc_node.next;
+
+					list_del(&desc->desc_node);
+					list_add_tail(&desc->desc_node, &v5chan->free_list);
+					desc->at = NULL;
+					desc->cyclic = false;
+					desc->num_sg = 0;
+				}
+			} else {
+				list_del(&desc->desc_node);
+				list_add_tail(&desc->desc_node, &v5chan->free_list);
+			}
+		}
+	}
+
+	if (!list_empty(&v5chan->active_list)) {
+		list_for_each_entry_safe(desc, _desc, &v5chan->active_list, desc_node) {
+			if (desc->cyclic == true) {
+				first_desc = desc;
+
+				desc_node = first_desc->tx_list.next;
+				list_del(&first_desc->desc_node);
+				list_add_tail(&first_desc->desc_node, &v5chan->free_list);
+
+				for (index = 1; index < first_desc->num_sg; index++) {
+					desc = list_entry(desc_node, struct v5_desc,
+						desc_node);
+
+					desc_node = desc->desc_node.next;
+
+					list_del(&desc->desc_node);
+					list_add_tail(&desc->desc_node, &v5chan->free_list);
+					desc->at = NULL;
+					desc->cyclic = false;
+					desc->num_sg = 0;
+				}
+			} else {
+				list_del(&desc->desc_node);
+				list_add_tail(&desc->desc_node, &v5chan->free_list);
+			}
+		}
+	}
+
 
 	clear_bit(V5_IS_PAUSED, &v5chan->status);
+	spin_unlock_irqrestore(&v5chan->lock, flags);
 
 	return 0;
 }
