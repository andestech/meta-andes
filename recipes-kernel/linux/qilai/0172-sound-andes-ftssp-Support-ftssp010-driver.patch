+#include <linux/init.h>
+#include <linux/module.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <sound/core.h>
+#include <sound/pcm.h>
+#include <sound/initval.h>
+#include <sound/asound.h>
+#include <linux/i2c.h>
+#include <sound/control.h>
+#include <linux/interrupt.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <asm/irq.h>
+#include <asm/io.h>
+#include <linux/uaccess.h>
+#include <linux/regmap.h>
+#include <linux/clk.h>
+
+#include <sound/dmaengine_pcm.h>
+#include <linux/device.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include "ftssp010.h"
+#include "andes_pcm.h"
+
+
+/* ---------------------------------------------------------------------------
+ * Define the debug level of FTSSP_DEBUG
+ */
+#define FTSSP_DEBUG     	0
+#define FTSSP_DEBUG_VERBOSE	0
+#define FTSSP_PROC_FS   	0
+
+#undef VVDBG
+#if (FTSSP_DEBUG_VERBOSE)
+#define VVDBG(vvar...)	(void)0
+#define VVDBG(vvar...)	printk(KERN_INFO vvar)
+#else
+#define VVDBG(vvar...)	(void)0
+#endif
+
+#undef ERR
+#define ERR(vvar...)	printk(KERN_ERR vvar)
+
+#undef INFO
+//#define INFO(vvar...)	printk(KERN_INFO vvar)
+#define INFO(vvar...)
+
+#if (FTSSP_DEBUG)
+#undef DBG
+#define DBG(vvar...)	printk(KERN_INFO vvar)
+#else
+#define DBG(vvar...)	(void)0
+#endif
+
+#if (FTSSP_DEBUG_VERBOSE)
+#undef VDBG
+#define VDBG(vvar...)	printk(KERN_INFO vvar)
+#else
+#define VDBG(vvar...)	(void)0
+#endif
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Faraday Technology Corp.");
+MODULE_DESCRIPTION("FTSSP010 Linux 2.6 Driver");
+
+// ----------------------------------------------
+
+struct ftssp010_i2s {
+	struct device *dev;
+	unsigned int mclk;
+	const struct regmap_config *regmap_conf;
+	struct regmap *regmap;
+	struct platform_device *pdev;
+	struct snd_dmaengine_dai_dma_data capture_dma_data;
+	struct snd_dmaengine_dai_dma_data playback_dma_data;
+	struct snd_dmaengine_pcm_config dma_config;
+};
+
+static void ftssp010_read_register(struct ftssp010_i2s *i2s)
+{
+	unsigned int val_isr, val_cr0, val_cr1, val_cr2, val_icr, val_stat;
+
+	regmap_read(i2s->regmap, FTSSP010_OFFSET_ISR, &val_isr);
+	regmap_read(i2s->regmap, FTSSP010_OFFSET_CR0, &val_cr0);
+	regmap_read(i2s->regmap, FTSSP010_OFFSET_CR1, &val_cr1);
+	regmap_read(i2s->regmap, FTSSP010_OFFSET_CR2, &val_cr2);
+	regmap_read(i2s->regmap, FTSSP010_OFFSET_ICR, &val_icr);
+	regmap_read(i2s->regmap, FTSSP010_OFFSET_STATUS, &val_stat);
+	INFO(">>> isr = %08x, ctrl0 = %08x, ctrl1 = %08x, ctrl2 = %08x, ctrl_int = %08x, status = %08x\n", val_isr, val_cr0, val_cr1, val_cr2, val_icr, val_stat);
+}
+
+extern void fill_codec_reg(void);
+static void ftssp010_i2s_start_playback(struct ftssp010_i2s *i2s)
+{
+	unsigned int reg;
+	INFO(">>> %s()\n", __func__);
+
+	reg = /* FTSSP010_ICR_TFUR |*/ FTSSP010_ICR_TFDMA | FTSSP010_ICR_RFDMA
+		| FTSSP010_ICR_RFTHOD(FTSSP010_RXFIFO_THRESHOLD) | FTSSP010_ICR_TFTHOD(FTSSP010_TXFIFO_THRESHOLD);
+	INFO("ftssp010-i2s start_playback: [ICR] = %08x\n", reg);
+	regmap_write(i2s->regmap, FTSSP010_OFFSET_ICR, reg);
+
+	reg = FTSSP010_CR2_TXDOE;
+	INFO("ftssp010-i2s start_playback: [CR2] = %08x\n", reg);
+	regmap_write(i2s->regmap, FTSSP010_OFFSET_CR2, reg);
+
+	reg = FTSSP010_CR2_SSPEN | FTSSP010_CR2_TXDOE;
+	INFO("ftssp010-i2s start_playback: [CR2] = %08x\n", reg);
+	regmap_write(i2s->regmap, FTSSP010_OFFSET_CR2, reg);
+
+	ftssp010_read_register(i2s);
+
+}
+
+static void ftssp010_i2s_stop_playback(struct ftssp010_i2s *i2s)
+{
+	INFO(">>> %s()\n", __func__);
+
+	regmap_update_bits(i2s->regmap, FTSSP010_OFFSET_ICR,
+			   FTSSP010_ICR_TFUR, 0);
+	regmap_update_bits(i2s->regmap, FTSSP010_OFFSET_ICR,
+			   FTSSP010_ICR_TFDMA, 0);
+	regmap_update_bits(i2s->regmap, FTSSP010_OFFSET_CR2,
+			   FTSSP010_CR2_SSPEN, 0);
+	regmap_update_bits(i2s->regmap, FTSSP010_OFFSET_CR2,
+			   FTSSP010_CR2_TXDOE, 0);
+}
+
+static void ftssp010_i2s_start_capture(struct ftssp010_i2s *i2s)
+{
+	unsigned int reg;
+	INFO(">>> %s()\n", __func__);
+
+	reg = FTSSP010_ICR_RFOR | FTSSP010_ICR_RFDMA | FTSSP010_ICR_TFDMA
+		| FTSSP010_ICR_RFTHOD(FTSSP010_RXFIFO_THRESHOLD) | FTSSP010_ICR_TFTHOD(FTSSP010_TXFIFO_THRESHOLD);
+	INFO("ftssp010-i2s start_capture: [ICR] = %08x\n", reg);
+	regmap_write(i2s->regmap, FTSSP010_OFFSET_ICR, reg);
+
+	reg = FTSSP010_CR2_SSPEN | FTSSP010_CR2_TXDOE;
+	INFO("ftssp010-i2s start_capture: [CR2] = %08x\n", reg);
+	regmap_write(i2s->regmap, FTSSP010_OFFSET_CR2, reg);
+
+	ftssp010_read_register(i2s);
+}
+
+static void ftssp010_i2s_stop_capture(struct ftssp010_i2s *i2s)
+{
+	INFO(">>> %s()\n", __func__);
+	regmap_update_bits(i2s->regmap, FTSSP010_OFFSET_ICR,
+			   FTSSP010_ICR_RFOR, 0);
+	regmap_update_bits(i2s->regmap, FTSSP010_OFFSET_ICR,
+			   FTSSP010_ICR_RFDMA, 0);
+}
+
+static int ftssp010_i2s_trigger(struct snd_pcm_substream *substream, int cmd,
+				struct snd_soc_dai *cpu_dai)
+{
+	struct ftssp010_i2s *i2s = snd_soc_dai_get_drvdata(cpu_dai);
+	INFO(">>> %s() cmd:%d\n", __func__, cmd);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+	case SNDRV_PCM_TRIGGER_RESUME:
+		if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK)
+			ftssp010_i2s_start_playback(i2s);
+		else
+			ftssp010_i2s_start_capture(i2s);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK)
+			ftssp010_i2s_stop_playback(i2s);
+		else
+			ftssp010_i2s_stop_capture(i2s);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+
+
+/**
+ * ftssp010_i2s_hw_params() - Setup CPU DAI resources according to hardware parameters
+ *
+ * Called by soc_pcm_hw_params().
+ */
+static int ftssp010_i2s_hw_params(struct snd_pcm_substream *substream,
+		struct snd_pcm_hw_params *params, struct snd_soc_dai *cpu_dai)
+{
+	struct device *dev = cpu_dai->dev;
+	struct ftssp010_i2s *i2s = snd_soc_dai_get_drvdata(cpu_dai);
+	struct snd_dmaengine_dai_dma_data *dma_data;
+
+	unsigned int rate = params_rate(params);
+	unsigned int channels = params_channels(params);
+	unsigned int cr0;
+	unsigned int cr1;
+	int data_len;
+	int padding;
+	unsigned int mclk_rate, bclk_rate, div_bclk;
+
+	INFO(">>> %s()\n", __func__);
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK)
+		dma_data = &i2s->playback_dma_data;
+	else
+		dma_data = &i2s->capture_dma_data;
+	snd_soc_dai_set_dma_data(cpu_dai, substream, dma_data);
+
+	regmap_read(i2s->regmap, FTSSP010_OFFSET_CR0, &cr0);
+	switch (channels) {
+	case 1:
+		cr0 &= ~FTSSP010_CR0_STEREO;
+		break;
+
+	case 2:
+		cr0 |= FTSSP010_CR0_STEREO;
+		break;
+
+	default:
+		dev_err(dev, "Invalid number of channels: %d\n",
+			channels);
+		return -EINVAL;
+	}
+
+	INFO("[CR0] = %08x\n", cr0);
+	regmap_write(i2s->regmap, FTSSP010_OFFSET_CR0, cr0);
+
+
+	/* bit size */
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S8:
+	case SNDRV_PCM_FORMAT_U8:
+		INFO("Support SNDRV_PCM_FORMAT_U8");
+		data_len = 8;
+		padding = 0;
+		break;
+
+	case SNDRV_PCM_FORMAT_S16:
+		INFO("Support SNDRV_PCM_FORMAT_S16");
+	case SNDRV_PCM_FORMAT_U16:
+		INFO("Support SNDRV_PCM_FORMAT_U16");
+		data_len = 16;
+		padding	= 0;
+		break;
+
+	case SNDRV_PCM_FORMAT_S24:
+	case SNDRV_PCM_FORMAT_U24:
+		INFO("Support SNDRV_PCM_FORMAT_U24");
+		data_len = 24;
+		padding = 8;
+		break;
+
+	case SNDRV_PCM_FORMAT_S32:
+	case SNDRV_PCM_FORMAT_U32:
+		INFO("Support SNDRV_PCM_FORMAT_U32");
+		data_len = 32;
+		padding = 0;
+		break;
+
+	default:
+		dev_err(dev, "Format not supported\n");
+		return -EINVAL;
+	}
+
+	cr1 = FTSSP010_CR1_SDL(data_len - 1) | FTSSP010_CR1_PDL(padding);
+
+	/* MCLK */
+	mclk_rate = i2s->mclk;
+	/* BCLK = channel * bit size * sampele rate */
+	bclk_rate = 2 * (data_len + padding) * rate;
+	div_bclk = (mclk_rate / (2 * bclk_rate)) - 1;
+
+	/*  debug purpose */
+//	div_bclk *= 27;
+//	div_bclk *= 21;
+//	div_bclk *= 18; //sin wave => output 2.27Hz
+//	div_bclk *= 3; //For 8000
+//	div_bclk *= 1; //sin wave => output 2KHz
+	div_bclk *= 2; //sin wave => output 1KHz
+
+	INFO("mclk_rate: %d, rate: %d, data_len: %d, padding: %d, blck_rate: %d, div_bclk: %d\n", mclk_rate, rate, data_len, padding, bclk_rate, div_bclk);
+
+/*	if (bclk_rate * div_bclk * 2 != mclk_rate) {
+		dev_err(dev, "Sample rate %d not supported\n", rate);
+		return -EINVAL;
+	}
+*/
+
+	cr1 |= FTSSP010_CR1_SCLKDIV(div_bclk);
+	INFO("[CR1] = %08x\n", cr1);
+	regmap_write(i2s->regmap, FTSSP010_OFFSET_CR1, cr1);
+
+	ftssp010_read_register(i2s);
+
+	return 0;
+}
+
+
+/**
+ * ftssp010_i2s_set_fmt() - Setup hardware according to the DAI format
+ *
+ * Called by snd_soc_dai_set_fmt().
+ */
+static int ftssp010_i2s_set_fmt(struct snd_soc_dai *cpu_dai,
+		unsigned int fmt)
+{
+	struct ftssp010_i2s *i2s = snd_soc_dai_get_drvdata(cpu_dai);
+	unsigned int cr0;
+
+	INFO(">>> %s fmt:0x%x\n", __func__, fmt);
+	cr0 = FTSSP010_CR0_FFMT_I2S;
+
+	/* interface format */
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		cr0 |= FTSSP010_CR0_FSDIST(1);
+		break;
+
+	case SND_SOC_DAIFMT_RIGHT_J:
+		cr0 |= FTSSP010_CR0_FSDIST(0);
+		cr0 |= FTSSP010_CR0_FSJSTFY;	/* padding in front of data */
+		break;
+
+	case SND_SOC_DAIFMT_LEFT_J:
+		cr0 |= FTSSP010_CR0_FSDIST(0);
+		break;
+
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		break;
+
+	case SND_SOC_DAIFMT_NB_IF:
+		cr0 |= FTSSP010_CR0_FSPO;	/* frame sync active low */
+		break;
+
+	default:
+		return -EINVAL;
+	}
+
+	/* set master/slave audio interface */
+	switch (fmt & SND_SOC_DAIFMT_MASTER_MASK) {
+	case SND_SOC_DAIFMT_CBM_CFM:
+		/*
+		 * codec is clock & frame master ->
+		 * interface is clock & frame slave
+		 */
+		break;
+
+	case SND_SOC_DAIFMT_CBS_CFS:
+		/*
+		 * codec is clock & frame slave ->
+		 * interface is clock & frame master
+		 */
+		cr0 |= FTSSP010_CR0_MASTER;
+		break;
+
+	default:
+ 		return -EINVAL;
+	}
+
+	cr0 |= FTSSP010_CR0_MASTER;
+
+	INFO("[CR0] = %08x\n", cr0);
+	pm_runtime_get_sync(cpu_dai->dev);
+	regmap_write(i2s->regmap, FTSSP010_OFFSET_CR0, cr0);
+	pm_runtime_put(cpu_dai->dev);
+
+	return 0;
+}
+
+static irqreturn_t ftssp010_i2s_isr(int irq, void *ftssp_i2s)
+{
+	struct ftssp010_i2s *i2s = ftssp_i2s;
+	unsigned int val;
+
+	regmap_read(i2s->regmap, FTSSP010_OFFSET_ISR, &val);
+
+	return IRQ_HANDLED;
+}
+
+static int ftssp010_i2s_dai_probe(struct snd_soc_dai *cpu_dai)
+{
+	struct ftssp010_i2s *i2s = snd_soc_dai_get_drvdata(cpu_dai);
+
+	INFO(">>> %s()\n", __func__);
+	cpu_dai->capture_dma_data = &i2s->capture_dma_data;
+	cpu_dai->playback_dma_data = &i2s->playback_dma_data;
+
+	snd_soc_dai_init_dma_data(cpu_dai, &i2s->playback_dma_data,
+			&i2s->capture_dma_data);
+
+	return 0;
+}
+
+
+static const struct snd_soc_dai_ops ftssp010_i2s_dai_ops = {
+	.hw_params = ftssp010_i2s_hw_params,
+	.set_fmt = ftssp010_i2s_set_fmt,
+	.trigger = ftssp010_i2s_trigger,
+};
+
+static struct snd_soc_dai_driver ftssp010_i2s_dai = {
+	.probe = ftssp010_i2s_dai_probe,
+	.name = "ssp_soc_dai",
+	.playback = {
+		.stream_name = "Playback",
+		.channels_min = 1,
+		.channels_max = 2,
+		.rates = SNDRV_PCM_RATE_8000_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.capture = {
+		.stream_name = "Capture",
+		.channels_min = 1,
+		.channels_max = 2,
+		.rates = SNDRV_PCM_RATE_8000_48000,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.ops = &ftssp010_i2s_dai_ops,
+	.symmetric_rate = 1,
+};
+
+
+static const struct snd_soc_component_driver ftssp010_i2s_component = {
+	.name		= "ftssp010-i2s",
+};
+
+static bool ftssp010_i2s_wr_reg(struct device *dev, unsigned int reg)
+{
+	switch (reg) {
+	case FTSSP010_OFFSET_DATA:
+	case FTSSP010_OFFSET_CR0:
+	case FTSSP010_OFFSET_CR1:
+	case FTSSP010_OFFSET_CR2:
+	case FTSSP010_OFFSET_ICR:
+		return true;
+	default:
+		return false;
+	}
+}
+static bool ftssp010_i2s_rd_reg(struct device *dev, unsigned int reg)
+{
+	switch (reg) {
+	case FTSSP010_OFFSET_DATA:
+	case FTSSP010_OFFSET_CR0:
+	case FTSSP010_OFFSET_CR1:
+	case FTSSP010_OFFSET_CR2:
+	case FTSSP010_OFFSET_ICR:
+	case FTSSP010_OFFSET_STATUS:
+	case FTSSP010_OFFSET_ISR:
+	case FTSSP010_OFFSET_REVISION:
+	case FTSSP010_OFFSET_FEATURE:
+	case FTSSP010_OFFSET_ACLSV:
+		return true;
+	default:
+		return false;
+	}
+}
+static bool ftssp010_i2s_volatile_reg(struct device *dev, unsigned int reg)
+{
+	switch (reg) {
+	case FTSSP010_OFFSET_DATA:
+	case FTSSP010_OFFSET_CR0:
+	case FTSSP010_OFFSET_CR1:
+	case FTSSP010_OFFSET_CR2:
+	case FTSSP010_OFFSET_ICR:
+		return true;
+	default:
+		return false;
+	}
+}
+static const struct regmap_config ftssp010_i2s_regmap_config = {
+	.reg_bits = 32,
+	.reg_stride = 4,
+	.val_bits = 32,
+	.max_register = FTSSP010_OFFSET_FEATURE,
+	.writeable_reg = ftssp010_i2s_wr_reg,
+	.readable_reg = ftssp010_i2s_rd_reg,
+	.volatile_reg = ftssp010_i2s_volatile_reg,
+	.cache_type = REGCACHE_FLAT,
+};
+
+static int ftssp010_i2s_probe(struct platform_device *pdev)
+{
+	int (*read_fixup)(void __iomem *addr, unsigned int val,
+		unsigned int shift_bits);
+	int ret;
+	/* Add for i2s */
+	struct ftssp010_i2s *i2s;
+	int err, irq;
+	unsigned int val;
+	unsigned int reg;
+	struct resource *mem;
+	void __iomem *regs;
+
+	i2s = devm_kzalloc(&pdev->dev, sizeof(*i2s), GFP_KERNEL);
+	if (!i2s) {
+		err = -ENOMEM;
+		goto err;
+	}
+	platform_set_drvdata(pdev, i2s);
+	i2s->dev = &pdev->dev;
+	INFO("dev: %p, i2s: %p\n", &pdev->dev, i2s);
+
+	mem = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	regs = devm_ioremap_resource(&pdev->dev, mem);
+
+	if (IS_ERR(regs)) {
+		ret = PTR_ERR(regs);
+		goto err;
+	}
+
+	/* Check SSP revision register */
+	read_fixup = symbol_get(readl_fixup);
+	ret = read_fixup((void __iomem *)(unsigned long)regs + 0x40,  0x00011506, 0);
+	symbol_put(readl_fixup);
+	if (!ret){
+		ERR("%s: fail to read revision reg, bitmap no support ftssp \n", __func__);
+		return -ENXIO;
+	}
+
+	i2s->regmap = devm_regmap_init_mmio(&pdev->dev, regs,
+					    &ftssp010_i2s_regmap_config);
+	if (IS_ERR(i2s->regmap)) {
+		dev_err(&pdev->dev, "regmap init failed\n");
+		err = PTR_ERR(i2s->regmap);
+		goto err;
+	}
+
+	i2s->playback_dma_data.addr = mem->start + FTSSP010_OFFSET_DATA;
+	i2s->playback_dma_data.addr_width = DMA_SLAVE_BUSWIDTH_4_BYTES;
+	i2s->playback_dma_data.maxburst = 4;
+	i2s->playback_dma_data.chan_name = "tx";
+
+	i2s->capture_dma_data.addr = mem->start + FTSSP010_OFFSET_DATA;
+	i2s->capture_dma_data.addr_width = DMA_SLAVE_BUSWIDTH_4_BYTES;
+	i2s->capture_dma_data.maxburst = 4;
+	i2s->capture_dma_data.chan_name = "rx";
+
+	/* SSP reset */
+ 	regmap_update_bits(i2s->regmap, FTSSP010_OFFSET_CR2,
+			   FTSSP010_CR2_SSPRST, 1);
+
+	mdelay(1);
+ 	regmap_update_bits(i2s->regmap, FTSSP010_OFFSET_CR2,
+			   FTSSP010_CR2_SSPRST, 0);
+	mdelay(1);
+	/* SSP disable interrupt source */
+ 	regmap_write(i2s->regmap, FTSSP010_OFFSET_ICR, 0);
+
+	/* SSP reset Control Register 0 */
+ 	regmap_write(i2s->regmap, FTSSP010_OFFSET_CR0, 0);
+
+	/* SSP Transmit/Receive FIFO clear */
+	reg = FTSSP010_CR2_RXFCLR | FTSSP010_CR2_TXFCLR;
+	INFO("ftssp010-i2s: [CR2] = %08x\n", reg);
+	regmap_write(i2s->regmap, FTSSP010_OFFSET_CR2, reg);
+
+ 	regmap_update_bits(i2s->regmap, FTSSP010_OFFSET_CR2,
+			  FTSSP010_CR2_RXFCLR, 0);
+
+ 	regmap_update_bits(i2s->regmap, FTSSP010_OFFSET_CR2,
+			  FTSSP010_CR2_TXFCLR, 0);
+
+	device_property_read_u32(&pdev->dev, "clock-frequency", &i2s->mclk);
+	INFO("i2s_mclk = %d\n", i2s->mclk);
+	if (!i2s->mclk) {
+		dev_err(&pdev->dev, "couldn't get clock\n");
+		err = PTR_ERR(i2s->mclk);
+		goto err;
+	}
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	err = request_irq(irq, ftssp010_i2s_isr, 0, "ftssp010", i2s);
+	if (err) {
+		pr_err("%s request irq failed %d\n", __func__, err);
+		goto err;
+	}
+
+	ret = devm_snd_soc_register_component(&pdev->dev, &ftssp010_i2s_component,
+				   &ftssp010_i2s_dai, 1);
+	if (ret) {
+		pr_err("Could not register DAI: %d\n", ret);
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	ret = andes_pcm_platform_register(&pdev->dev);
+	if (ret) {
+		pr_err("Could not register PCM: %d\n", ret);
+		goto err;
+	}
+
+	fill_codec_reg();
+
+	return 0;
+
+err:
+	dev_err(&pdev->dev, "%s: err = %d\n", __func__, err);
+	return err;
+
+}
+
+static int ftssp010_i2s_remove(struct platform_device *pdev)
+{
+	DBG("%s, cleaning up\n",__func__);
+	andes_pcm_platform_unregister(&pdev->dev);
+	snd_soc_unregister_component(&pdev->dev);
+
+	return 0;
+}
+
+static const struct of_device_id ftssp010_i2s_of_match[] = {
+	{ .compatible = "andestech,ftsspi2s", },
+	{},
+};
+
+static struct platform_driver ftssp010_i2s_driver = {
+	.driver = {
+		.name = "ftssp010",
+		.owner = THIS_MODULE,
+		.of_match_table = ftssp010_i2s_of_match,
+	},
+	.probe = ftssp010_i2s_probe,
+	.remove = ftssp010_i2s_remove,
+};
+module_platform_driver(ftssp010_i2s_driver);
