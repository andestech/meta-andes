--- /dev/null
+++ b/sound/soc/andes/andes_pcm_dmaengin.c
@@ -0,0 +1,47 @@
+/*
+ * andes_pcm.c - Andes PCM driver
+ *
+ */
+
+#include <linux/module.h>
+#include <sound/core.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/dmaengine_pcm.h>
+
+#include "andes_pcm.h"
+
+static const struct snd_pcm_hardware andes_pcm_hardware = {
+	.info			= SNDRV_PCM_INFO_MMAP |
+				  SNDRV_PCM_INFO_MMAP_VALID |
+				  SNDRV_PCM_INFO_INTERLEAVED,
+	.period_bytes_min	= 1024,
+	.period_bytes_max	= PAGE_SIZE,
+	.periods_min		= 2,
+	.periods_max		= 8,
+	.buffer_bytes_max	= PAGE_SIZE * 8,
+	.fifo_size		= 4,
+};
+
+static const struct snd_dmaengine_pcm_config andes_dmaengine_pcm_config = {
+	.pcm_hardware = &andes_pcm_hardware,
+	.prepare_slave_config = snd_dmaengine_pcm_prepare_slave_config,
+	.prealloc_buffer_size = PAGE_SIZE * 8,
+};
+
+int andes_pcm_platform_register(struct device *dev)
+{
+	return snd_dmaengine_pcm_register(dev, &andes_dmaengine_pcm_config, 0);
+}
+EXPORT_SYMBOL_GPL(andes_pcm_platform_register);
+
+void andes_pcm_platform_unregister(struct device *dev)
+{
+	return snd_dmaengine_pcm_unregister(dev);
+}
+EXPORT_SYMBOL_GPL(andes_pcm_platform_unregister);
+
+MODULE_AUTHOR("Mina Chou <minachou@andestech.com>");
+MODULE_DESCRIPTION("Andes PCM ASoC driver");
+MODULE_LICENSE("GPL");
diff --git a/sound/soc/andes/andes_rt5640.c b/sound/soc/andes/andes_rt5640.c
new file mode 100644
index 000000000000..72a74d2fda40
--- /dev/null
+++ b/sound/soc/andes/andes_rt5640.c
@@ -0,0 +1,224 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ASoC machine driver for boards using a RT5640 CODEC.
+ *
+ * Copyright (C) 2021 Andes Technology Corporation
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/gpio.h>
+#include <linux/of_gpio.h>
+#include <linux/delay.h>
+#include <sound/core.h>
+#include <sound/jack.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include "ftssp010.h"
+#include "../codecs/rt5640.h"
+
+#define DRV_NAME "andes-snd-rt5640"
+
+static struct snd_soc_jack andes_rt5640_headset_jack;
+
+static struct snd_soc_jack_pin andes_rt5640_hp_jack_pins[] = {
+	{
+		.pin = "Headphones",
+		.mask = SND_JACK_HEADPHONE,
+	},
+};
+
+static const struct snd_soc_dapm_widget andes_rt5640_dapm_widgets[] = {
+	SND_SOC_DAPM_HP("Headphones", NULL),
+	SND_SOC_DAPM_SPK("Speakers", NULL),
+	SND_SOC_DAPM_MIC("Mic Jack", NULL),
+};
+
+static const struct snd_soc_dapm_route andes_rt5640_audio_map[] = {
+	/* Input Lines */
+	{"Mic Jack", NULL, "MICBIAS1"},
+	{"IN2P", NULL, "Mic Jack"},
+
+	/* Output Lines */
+	{"Headphones", NULL, "HPOR"},
+	{"Headphones", NULL, "HPOL"},
+};
+
+static const struct snd_kcontrol_new andes_rt5640_controls[] = {
+	SOC_DAPM_PIN_SWITCH("Headphones"),
+	SOC_DAPM_PIN_SWITCH("Speakers"),
+	SOC_DAPM_PIN_SWITCH("Mic Jack"),
+};
+
+static int andes_rt5640_hw_params(struct snd_pcm_substream *substream,
+			     struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = asoc_substream_to_rtd(substream);
+	struct snd_soc_dai *codec_dai = asoc_rtd_to_codec(rtd, 0);
+	int ret = 0;
+
+ 	ret = snd_soc_dai_set_sysclk(codec_dai, RT5640_SCLK_S_PLL1,
+				     params_rate(params) * 256,
+				     SND_SOC_CLOCK_IN);
+	if (ret < 0) {
+		dev_err(codec_dai->dev, "can't set codec clock %d\n", ret);
+		return ret;
+	}
+	ret = snd_soc_dai_set_pll(codec_dai, 0, RT5640_PLL1_S_BCLK1,
+				  params_rate(params) * 32,
+				  params_rate(params) * 256);
+	if (ret < 0) {
+		dev_err(codec_dai->dev, "can't set codec pll: %d\n", ret);
+		return ret;
+	}
+
+	return ret;
+}
+
+static int andes_rt5640_init(struct snd_soc_pcm_runtime *runtime)
+{
+	struct snd_soc_card *card = runtime->card;
+	int ret;
+
+	dev_info(card->dev, ">>> %s\n", __func__);
+
+	/* Enable Headset and 4 Buttons Jack detection */
+	ret = snd_soc_card_jack_new_pins(card, "Headphones",
+				    SND_JACK_HEADPHONE | SND_JACK_MICROPHONE,
+				    &andes_rt5640_headset_jack, andes_rt5640_hp_jack_pins,
+				    ARRAY_SIZE(andes_rt5640_hp_jack_pins));
+	if (ret) {
+		dev_err(card->dev, "New Headset Jack failed! (%d)\n", ret);
+		return ret;
+	}
+	return 0;
+
+}
+
+static const struct snd_soc_ops andes_rt5640_ops = {
+	.hw_params = andes_rt5640_hw_params,
+};
+
+SND_SOC_DAILINK_DEFS(pcm,
+	DAILINK_COMP_ARRAY(COMP_EMPTY()),
+	DAILINK_COMP_ARRAY(COMP_CODEC(NULL, "rt5640-aif1")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+static struct snd_soc_dai_link andes_rt5640_dai = {
+	.name = "rt5640",
+	.stream_name = "rt5640 PCM",
+	.init = andes_rt5640_init,
+	.ops = &andes_rt5640_ops,
+	/* set rt5640 as slave */
+	.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+		SND_SOC_DAIFMT_CBS_CFS,
+	SND_SOC_DAILINK_REG(pcm),
+};
+
+static struct snd_soc_card snd_soc_card_andes_rt5640 = {
+	.name = "RT5640-I2S",
+	.owner = THIS_MODULE,
+	.dai_link = &andes_rt5640_dai,
+	.num_links = 1,
+	.dapm_widgets = andes_rt5640_dapm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(andes_rt5640_dapm_widgets),
+	.dapm_routes = andes_rt5640_audio_map,
+	.num_dapm_routes = ARRAY_SIZE(andes_rt5640_audio_map),
+	.controls = andes_rt5640_controls,
+	.num_controls = ARRAY_SIZE(andes_rt5640_controls),
+};
+
+static int andes_rt5640_probe(struct platform_device *pdev)
+{
+	int ret = 0;
+	struct snd_soc_card *card = &snd_soc_card_andes_rt5640;
+	struct device_node *np = pdev->dev.of_node;
+
+	/* register the soc card */
+	card->dev = &pdev->dev;
+	dev_info(&pdev->dev, ">>> %s\n", __func__);
+
+	andes_rt5640_dai.codecs->of_node = of_parse_phandle(np,
+			"andes,audio-codec", 0);
+	if (!andes_rt5640_dai.codecs->of_node) {
+		dev_err(&pdev->dev,
+			"Property 'andes,audio-codec' missing or invalid\n");
+		return -EINVAL;
+	}
+
+	andes_rt5640_dai.cpus->of_node = of_parse_phandle(np,
+			"andes,i2s-controller", 0);
+	if (!andes_rt5640_dai.cpus->of_node) {
+		dev_err(&pdev->dev,
+			"Property 'andes,i2s-controller' missing or invalid\n");
+		ret = -EINVAL;
+		goto put_codec_of_node;
+	}
+
+	andes_rt5640_dai.platforms->of_node = andes_rt5640_dai.cpus->of_node;
+
+	ret = snd_soc_of_parse_card_name(card, "andes,model");
+	if (ret) {
+		dev_err(&pdev->dev,
+			"Soc parse card name failed %d\n", ret);
+		goto put_cpu_of_node;
+	}
+
+	ret = devm_snd_soc_register_card(&pdev->dev, card);
+	if (ret) {
+		dev_err(&pdev->dev,
+			"Soc register card failed %d\n", ret);
+		goto put_cpu_of_node;
+	}
+
+	return ret;
+
+put_cpu_of_node:
+	of_node_put(andes_rt5640_dai.cpus->of_node);
+	andes_rt5640_dai.cpus->of_node = NULL;
+put_codec_of_node:
+	of_node_put(andes_rt5640_dai.codecs->of_node);
+	andes_rt5640_dai.codecs->of_node = NULL;
+
+	return ret;
+}
+
+static int andes_rt5640_remove(struct platform_device *pdev)
+{
+	struct snd_soc_card *card = platform_get_drvdata(pdev);
+
+	dev_info(&pdev->dev, ">>> %s\n", __func__);
+	snd_soc_unregister_card(card);
+	of_node_put(andes_rt5640_dai.cpus->of_node);
+	andes_rt5640_dai.cpus->of_node = NULL;
+	of_node_put(andes_rt5640_dai.codecs->of_node);
+	andes_rt5640_dai.codecs->of_node = NULL;
+
+	return 0;
+}
+
+static const struct of_device_id andes_rt5640_of_match[] = {
+	{ .compatible = "andes,andes-audio-rt5640", },
+	{},
+};
+
+MODULE_DEVICE_TABLE(of, andes_rt5640_of_match);
+
+static struct platform_driver andes_rt5640_driver = {
+	.probe = andes_rt5640_probe,
+	.remove = andes_rt5640_remove,
+	.driver = {
+		.name = DRV_NAME,
+		.pm = &snd_soc_pm_ops,
+		.of_match_table = andes_rt5640_of_match,
+	},
+};
+
+module_platform_driver(andes_rt5640_driver);
+
+MODULE_AUTHOR("Mina Chou <minachou@andestech.com>");
+MODULE_DESCRIPTION("andes technology rt5640 machine ASoC driver");
+MODULE_LICENSE("GPL v2");
+MODULE_ALIAS("platform:" DRV_NAME);
