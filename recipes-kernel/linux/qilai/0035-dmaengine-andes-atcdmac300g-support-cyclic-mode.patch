-	spin_unlock_irqrestore(&v5chan->lock, flags);
 
 	return 0;
 }
@@ -653,25 +883,38 @@ v5_tx_status(struct dma_chan *chan,
 		dma_cookie_t cookie,
 		struct dma_tx_state *txstate)
 {
-	struct v5_dma_chan	*v5chan = to_v5_dma_chan(chan);
