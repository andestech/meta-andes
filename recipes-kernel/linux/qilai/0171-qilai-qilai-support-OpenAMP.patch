From 65b6bab6eccb7a57f9e8c9712479e1e46372482b Mon Sep 17 00:00:00 2001
From: Locus Wei-Han Chen <locus84@andestech.com>
Date: Fri, 29 Mar 2024 17:22:59 +0800
Subject: [PATCH 171/191] qilai: qilai support OpenAMP

Signed-off-by: Locus Wei-Han Chen <locus84@andestech.com>
---
 arch/riscv/Makefile                    |   2 +-
 arch/riscv/boot/dts/andes/qilai.dts    |  60 +++
 arch/riscv/configs/qilai_openmp.config |  17 +
 arch/riscv/include/asm/smp.h           |   4 +
 arch/riscv/kernel/smp.c                |  35 +-
 drivers/remoteproc/Kconfig             |   3 +
 drivers/remoteproc/Makefile            |   1 +
 drivers/remoteproc/qilai_remoteproc.c  | 491 +++++++++++++++++++++++++
 drivers/remoteproc/remoteproc_core.c   |  13 +-
 drivers/soc/andes/andes_sbi.c          |  14 +
 drivers/soc/andes/ppma.c               |   9 +-
 include/linux/remoteproc.h             |  18 +-
 include/soc/andes/sbi.h                |   7 +-
 13 files changed, 654 insertions(+), 20 deletions(-)
