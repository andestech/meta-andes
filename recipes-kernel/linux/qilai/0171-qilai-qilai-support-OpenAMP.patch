diff --git a/arch/riscv/kernel/smp.c b/arch/riscv/kernel/smp.c
index 8c3b59f1f9b8..68676eb01019 100644
--- a/arch/riscv/kernel/smp.c
+++ b/arch/riscv/kernel/smp.c
@@ -24,6 +24,13 @@
 #include <asm/tlbflush.h>
 #include <asm/cacheflush.h>
 #include <asm/cpu_ops.h>
+#include <linux/workqueue.h>
+
+struct remoteproc_check {
+	void (*check) (void *info);
+	void *info;
+};
+struct remoteproc_check rproc_amp = { .check = NULL, .info = NULL };
 
 enum ipi_message_type {
 	IPI_RESCHEDULE,
@@ -166,8 +173,12 @@ void handle_IPI(struct pt_regs *regs)
 		mb();
 
 		ops = xchg(pending_ipis, 0);
-		if (ops == 0)
+		if (ops == 0) {
+			if(rproc_amp.check) {
+				rproc_amp.check(rproc_amp.info);
+			}
 			return;
+		}
 
 		if (ops & (1 << IPI_RESCHEDULE)) {
 			stats[IPI_RESCHEDULE]++;
@@ -333,3 +344,25 @@ void smp_send_reschedule(int cpu)
 	send_ipi_single(cpu, IPI_RESCHEDULE);
 }
 EXPORT_SYMBOL_GPL(smp_send_reschedule);
+
+int smp_add_amp_check(void* ptr, void* info)
+{
+	if (!rproc_amp.check) {
+		rproc_amp.check = ptr;
+		rproc_amp.info = info;
+		return 0;
+	}
+	return -EINVAL;
+}
+EXPORT_SYMBOL(smp_add_amp_check);
+
+int smp_del_amp_check(void)
+{
+	if (rproc_amp.check != NULL) {
+		rproc_amp.check = NULL;
+		rproc_amp.info = NULL;
+		return 0;
+	}
+	return -EINVAL;
+}
+EXPORT_SYMBOL(smp_del_amp_check);
