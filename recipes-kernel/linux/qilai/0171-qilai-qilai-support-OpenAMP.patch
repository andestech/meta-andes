diff --git a/arch/riscv/Makefile b/arch/riscv/Makefile
index d95009156884..450921d21526 100644
--- a/arch/riscv/Makefile
+++ b/arch/riscv/Makefile
@@ -225,4 +225,4 @@ ae350_rv64_ax25_amp_defconfig:
 
 PHONY += qilai_rv64_smp_defconfig
 qilai_rv64_smp_defconfig:
-	$(Q)$(MAKE) -f $(srctree)/Makefile andes_defconfig andes-support.config 64-bit.config smp.config sv39.config qilai.config
\ No newline at end of file
+	$(Q)$(MAKE) -f $(srctree)/Makefile andes_defconfig andes-support.config 64-bit.config smp.config sv39.config qilai.config qilai_openmp.config
diff --git a/arch/riscv/boot/dts/andes/qilai.dts b/arch/riscv/boot/dts/andes/qilai.dts
index e56e1c7fa437..8554a92a2efa 100644
--- a/arch/riscv/boot/dts/andes/qilai.dts
+++ b/arch/riscv/boot/dts/andes/qilai.dts
@@ -142,6 +142,66 @@ memory@400000000 {
 		reg = <0x04 0x00000000 0x4 0x00000000>;
 	};
 
+	reserved-memory {
+		#address-cells = <0x2>;
+		#size-cells = <0x2>;
+		ranges;
+
+		andes_spbase:andes_spbase@43f000000 {
+			no-map;
+			reg = <0x4 0x3f000000 0x0 0x800000>;
+			aligment = <0x1000>;
+		};
+		test1:test1@43f800000 {
+			no-map;
+			reg = <0x4 0x3f800000 0x0 0x7e4000>;
+		};
+		vdev0buffer:vdev0buffer@43ffe4000 {
+			no-map;
+			reg = <0x4 0x3ffe4000 0x0 0x8000>;
+			alignment = <0x100>;
+		};
+		test2:test@43ffec000 {
+			no-map;
+			reg = <0x4 0x3ffec000 0x0 0x4000>;
+		};
+		/* RX vring from AX45mp, TX ring(NX27V view) */
+		vdev0vring0:vdev0vring0@43fff0000 {
+			no-map;
+			reg = <0x4 0x3fff0000 0x0 0x4000>;
+			alignment = <0x100>;
+		};
+		/* TX vring from AX45mp, RX ring(NX27V view) */
+		vdev0vring1:vdev0vring1@43fff4000 {
+			no-map;
+			reg = <0x4 0x3fff4000 0x0 0x4000>;
+			alignment = <0x100>;
+		};
+		andes_rsc_table:andes_rsc_table@43fff8000 {
+			no-map;
+			reg = <0x4 0x3fff8000 0x0 0x4000>;
+			aligment = <0x400>;
+		};
+		andes_swmbox:andes_swmbox@43fffc000 {
+			no-map;
+			reg = <0x4 0x3fffc000 0x0 0x4000>;
+			aligment = <0x1000>;
+		};
+	};
+
+	andes_remoteproc {
+		#address-cells = <0x2>;
+		#size-cells = <0x2>;
+		compatible = "andestech,andes_remoteproc";
+		memory-region = <&andes_spbase>, <&test1>,<&vdev0buffer>,<&test2>,
+		        <&vdev0vring0>, <&vdev0vring1>, <&andes_rsc_table>;
+		openamp-interrupt-method = "swplic";
+		mp_hartid = <0x1>;
+		sp_hartid = <0x4>;
+		rmem_base = <0x4 0x3f000000>;
+		rmem_size = <0x0 0x01000000>;
+	};
+
 	soc {
 		#address-cells = <0x2>;
 		#size-cells = <0x2>;
diff --git a/arch/riscv/configs/qilai_openmp.config b/arch/riscv/configs/qilai_openmp.config
