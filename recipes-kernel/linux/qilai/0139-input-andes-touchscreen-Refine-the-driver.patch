-#define READ_X			( ADS_A2A1A0_d_x  | ADS_12_BIT | ADS_DFR)
-#define READ_Y			( ADS_A2A1A0_d_y  | ADS_12_BIT | ADS_DFR)
-#define READ_Z1			( ADS_A2A1A0_d_z1 | ADS_12_BIT | ADS_DFR)
