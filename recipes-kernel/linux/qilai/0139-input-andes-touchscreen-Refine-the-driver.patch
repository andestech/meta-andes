 		err = -ENOMEM;
 		goto err_free_mem;
 	}
@@ -323,16 +331,18 @@ static int ads7846_probe(struct platform_device *pdev)
 	return err;
 }
 
-static struct platform_driver ads7846_driver =
-{
+static struct platform_driver ads7846_driver = {
 	.driver = {
