 	rproc->state = RPROC_RUNNING;
 
-	dev_info(dev, "remote processor %s is now up\n", rproc->name);
+        /* for Qilai OpenAMP  */
+	//dev_info(dev, "remote processor %s is now up\n", rproc->name);
 
 	return 0;
 
@@ -1382,8 +1383,8 @@ static int rproc_fw_boot(struct rproc *rproc, const struct firmware *fw)
 	if (ret)
 		return ret;
 
-//	dev_info(dev, "Booting fw image %s, size %zd\n", name, fw->size);
-	dev_info(dev, "Booting fw\n");
+        //dev_info(dev, "Booting fw image %s, size %zd\n", name, fw->size);
+	//dev_info(dev, "Booting fw\n");
 
 	/*
 	 * if enabling an IOMMU isn't relevant for this rproc, this is
@@ -1734,7 +1735,8 @@ static int rproc_stop(struct rproc *rproc, bool crashed)
 
 	rproc->state = RPROC_OFFLINE;
 
-	dev_info(dev, "stopped remote processor %s\n", rproc->name);
+        /* for Qilai OpenAMP */
+	//dev_info(dev, "stopped remote processor %s\n", rproc->name);
 
 	return 0;
 }
@@ -1941,7 +1943,8 @@ int rproc_boot(struct rproc *rproc)
 
 		ret = rproc_attach(rproc);
 	} else {
-		dev_info(dev, "powering up %s\n", rproc->name);
+                /* for qilai OpenAMP */
+		//dev_info(dev, "powering up %s\n", rproc->name);
 
 		/* load firmware */
 		ret = request_firmware(&firmware_p, rproc->firmware, dev);
