From 09ecb42101c045bfe93d959da3ceaecc97b1fce7 Mon Sep 17 00:00:00 2001
From: Randolph <randolph@andestech.com>
Date: Fri, 3 May 2024 15:20:34 +0800
Subject: [PATCH 175/191] renemae SOC_RESET_VECTOR to SMU_RESET_VECTOR

remove all nnessary printf
in rpmsg
in ppma
in remoteproc

Signed-off-by: Randolph <randolph@andestech.com>
---
 drivers/remoteproc/qilai_remoteproc.c  | 11 ++++++-----
 drivers/remoteproc/remoteproc_core.c   | 13 ++++++++-----
 drivers/remoteproc/remoteproc_virtio.c | 10 ++++++----
 drivers/rpmsg/mtk_rpmsg.c              |  2 +-
 drivers/rpmsg/rpmsg_ns.c               |  7 ++++---
 drivers/rpmsg/virtio_rpmsg_bus.c       |  3 ++-
 drivers/soc/andes/ppma.c               |  2 --
 7 files changed, 27 insertions(+), 21 deletions(-)

diff --git a/drivers/remoteproc/qilai_remoteproc.c b/drivers/remoteproc/qilai_remoteproc.c
index c62da77ab7d1..7340f1f3a876 100644
--- a/drivers/remoteproc/qilai_remoteproc.c
+++ b/drivers/remoteproc/qilai_remoteproc.c
@@ -30,8 +30,9 @@
 #define SOC_NX_RESET_BIT	2
 #define SOC_NX_RW_RESET_BIT		19
 #define SOC_BOOT_CTRL_OFFSET (SOC_OFFSET + 0x4C)
-#define SOC_RESET_VECTOR_LO_OFFSET (0x78)
-#define SOC_RESET_VECTOR_HI_OFFSET (0x7C)
+
+#define SMU_RESET_VECTOR_LO_OFFSET (0x78)
+#define SMU_RESET_VECTOR_HI_OFFSET (0x7C)
 
 /* PMA napot is 0x10FDFFFFF */
 #define SP_BASE 		0x43f000000
@@ -113,7 +114,6 @@ void check_for_openamp_sp(void *info)
 	if (swmbox_base) {
 		reg_value = readl(swmbox_base + SBI_OFF);
 		if (reg_value) {
-			printk(KERN_INFO "[%s] reg_value:%08x\n", __func__, reg_value);
 			writel(0, swmbox_base + SBI_OFF);
 			andes_amp_trace(AMP_MP_HANDLE_EVENT);
 			queue_work(qilai_vq_wq, &rpc_work.work);
@@ -143,8 +143,8 @@ static int andes_rproc_start(struct rproc *rproc)
 
 	/* MP set ELF entry point to the SP reset vector. */
 
-	writel((unsigned int)(SP_BASE), atcsmu.base + SOC_RESET_VECTOR_LO_OFFSET);
-	writel((unsigned int)(SP_BASE >> 32), atcsmu.base + SOC_RESET_VECTOR_HI_OFFSET);
+	writel((unsigned int)(SP_BASE), atcsmu.base + SMU_RESET_VECTOR_LO_OFFSET);
+	writel((unsigned int)(SP_BASE >> 32), atcsmu.base + SMU_RESET_VECTOR_HI_OFFSET);
 
 	reg_value = readl(atcsmu.base + SOC_NX_RESET_OFFSET);
 
@@ -411,6 +411,7 @@ static int andes_remoteproc_probe(struct platform_device *pdev)
 	}
 
 	swmbox_base = local->mbox_msg;
+        memset(swmbox_base, 0x0, sizeof(struct swmsg_box));
 
 	andes_amp_trace(AMP_MP_SBI_ENABLE);
 	sbi_swplic_openamp_idx(1);
