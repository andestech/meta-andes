new file mode 100644
index 000000000000..33ebf1132773
--- /dev/null
+++ b/drivers/video/fbdev/ftlcdc100/faradayfb-main.c
@@ -0,0 +1,867 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
