+		.start = ftssp010_start_tx,
+		.pmu_set_clocking = pmu_set_i2s_clocking,
+		.hw_config = ftssp010_config_tx,
+	},
+	/* Capture substream */
+	{
+		.busy = 0,
+		.start = ftssp010_start_rx,
+		.pmu_set_clocking = pmu_set_i2s_clocking,
+		.hw_config = ftssp010_config_rx,
+	}
+};
