+#define SSP_RFVE                    0x1f0   /* RX FIFO Valid Entries */
+#define SSP_FIFO_THOD               0xc400
+/* status register */
+#define WBUSY			    0x08000000
+#define ACTXDATA		    0x01000000
+#define SSP_BUSY                    0x4
+
+u32 __iomem *ssp2_vbase;
