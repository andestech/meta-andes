diff --git a/include/sbi_utils/ipi/qilai_plicsw.h b/include/sbi_utils/ipi/qilai_plicsw.h
new file mode 100644
index 0000000..94a7a56
--- /dev/null
+++ b/include/sbi_utils/ipi/qilai_plicsw.h
@@ -0,0 +1,44 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2022 Andes Technology Corporation
+ *
+ * Authors:
+ *   Zong Li <zong@andestech.com>
+ *   Nylon Chen <nylon7@andestech.com>
+ *   Leo Yu-Chi Liang <ycliang@andestech.com>
+ *   Yu Chien Peter Lin <peterlin@andestech.com>
+ */
+
+#ifndef _IPI_QILAI_PLICSW_H_
+#define _IPI_QILAI_PLICSW_H_
+
+#define PLICSW_PRIORITY_BASE    0x4
+
+#define PLICSW_PENDING_BASE     0x1000
+
+#define PLICSW_ENABLE_BASE      0x2000
+#define PLICSW_ENABLE_STRIDE    0x80
+
+#define PLICSW_CONTEXT_BASE     0x00200000
+#define PLICSW_CONTEXT_STRIDE   0x1000
+#define PLICSW_CONTEXT_CLAIM    0x4
+
+#define PLICSW_REGION_ALIGN     0x1000
+
+#define BITS_PER_REG            32
+#define BYTES_PER_REG           4
+
+struct plicsw_data {
+	unsigned long   addr;
+	unsigned long   size;
+	uint32_t        hart_count;
+};
+
+void plicsw_ipi_send(u32 target_hart);
+void plicsw_ipi_openamp_enable(u32 idx);
+void plicsw_ipi_clear(u32 target_hart);
+int plicsw_warm_ipi_init(void);
+int plicsw_cold_ipi_init(struct plicsw_data *plicsw);
+
+#endif /* _IPI_QILAI_PLICSW_H_ */
diff --git a/lib/sbi/sbi_ipi.c b/lib/sbi/sbi_ipi.c
index 7aafbbd..42e07c8 100644
--- a/lib/sbi/sbi_ipi.c
+++ b/lib/sbi/sbi_ipi.c
@@ -149,7 +149,7 @@ static struct sbi_ipi_event_ops ipi_smode_ops = {
 	.process = sbi_ipi_process_smode,
 };
 
-static u32 ipi_smode_event = SBI_IPI_EVENT_MAX;
+u32 ipi_smode_event = SBI_IPI_EVENT_MAX;
 
 int sbi_ipi_send_smode(ulong hmask, ulong hbase)
 {
@@ -283,3 +283,29 @@ void sbi_ipi_exit(struct sbi_scratch *scratch)
 	/* Platform exit */
 	sbi_platform_ipi_exit(sbi_platform_ptr(scratch));
 }
+
+int sbi_ipi_remote_event(u32 event, u32 remote_hartid)
+{
+	struct sbi_scratch *remote_scratch = NULL;
+	struct sbi_ipi_data *ipi_data;
+
+	if ((SBI_IPI_EVENT_MAX <= event) ||
+	    !ipi_ops_array[event])
+		return SBI_EINVAL;
+
+	remote_scratch = sbi_hartid_to_scratch(remote_hartid);
+	if (!remote_scratch)
+		return SBI_EINVAL;
+
+	ipi_data = sbi_scratch_offset_ptr(remote_scratch, ipi_data_off);
+
+	/*
+	 * Set IPI type on remote hart's scratch area and
+	 * trigger the interrupt
+	 */
+	atomic_raw_set_bit(event, &ipi_data->ipi_type);
+
+	smp_wmb();
+
+	return 0;
+}
