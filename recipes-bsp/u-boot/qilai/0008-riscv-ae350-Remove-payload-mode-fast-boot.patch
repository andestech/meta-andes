From: Leo Yu-Chi Liang <ycliang@andestech.com>
Date: Mon, 25 Jul 2022 14:09:41 +0800
Subject: [PATCH 08/34] riscv: ae350: Remove payload mode fast boot

Signed-off-by: Leo Yu-Chi Liang <ycliang@andestech.com>
---
 arch/riscv/Kconfig                           |  6 --
 arch/riscv/dts/binman_p.dtsi                 | 74 --------------------
 board/AndesTech/ae350/Kconfig                |  4 --
 configs/ae350_rv32_spl_payload_defconfig     | 46 ------------
 configs/ae350_rv32_spl_xip_payload_defconfig | 48 -------------
 configs/ae350_rv64_spl_payload_defconfig     | 47 -------------
 configs/ae350_rv64_spl_xip_payload_defconfig | 49 -------------
 7 files changed, 274 deletions(-)
 delete mode 100644 arch/riscv/dts/binman_p.dtsi
 delete mode 100644 configs/ae350_rv32_spl_payload_defconfig
 delete mode 100644 configs/ae350_rv32_spl_xip_payload_defconfig
 delete mode 100644 configs/ae350_rv64_spl_payload_defconfig
 delete mode 100644 configs/ae350_rv64_spl_xip_payload_defconfig

diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
index 666e743f1f..30b08aa263 100644
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -258,12 +258,6 @@ config SPL_LOAD_FIT_DYNAMIC
 	help
 	  Use fw_dynamic from the FIT image.
 
-config SPL_LOAD_FIT_PAYLOAD
-	bool "Enable SPL (payload mode) applying linux from FIT"
-	depends on SPL_LOAD_FIT
-	help
-	  Use fw_payload from the FIT image.
-
 endchoice
 
 config SPL_LOAD_FIT_CONFIG
diff --git a/arch/riscv/dts/binman_p.dtsi b/arch/riscv/dts/binman_p.dtsi
deleted file mode 100644
index 7bafaf8185..0000000000
--- a/arch/riscv/dts/binman_p.dtsi
+++ /dev/null
@@ -1,74 +0,0 @@
-// SPDX-License-Identifier: GPL-2.0+
-/*
- * Copyright (C) 2021, Bin Meng <bmeng.cn@gmail.com>
- */
-
-#include <config.h>
-
-/ {
-	binman: binman {
-		multiple-images;
-	};
-};
-
-&binman {
-	itb {
-		filename = "linux.itb";
-
-		fit {
-			description = "Configuration to load OpenSBI before Linux";
-			#address-cells = <1>;
-			fit,fdt-list = "of-list";
-
-			images {
-				linux {
-					description = "Linux";
-					type = "standalone";
-					os = "Linux";
-					arch = "riscv";
-					compression = "none";
-					load = <CONFIG_SYS_TEXT_BASE>;					
-				};
-
-				opensbi {
-					description = "OpenSBI fw_payload Firmware";
-					type = "firmware";
-					os = "opensbi";
-					arch = "riscv";
-					compression = "none";
-					load = <CONFIG_SPL_OPENSBI_LOAD_ADDR>;
-					entry = <CONFIG_SPL_OPENSBI_LOAD_ADDR>;
-
-					opensbi_blob: opensbi {
-						filename = "fw_payload.bin";
-					};
-				};
-
-#ifndef CONFIG_OF_BOARD
-				@fdt-SEQ {
-					description = "NAME";
-					type = "flat_dt";
-					compression = "none";
-				};
-#endif
-			};
-
-			configurations {
-				default = "conf-1";
-
-#ifndef CONFIG_OF_BOARD
-				@conf-SEQ {
-#else
-				conf-1 {
-#endif
-					description = "NAME";
-					firmware = "opensbi";
-					loadables = "linux";
-#ifndef CONFIG_OF_BOARD
-					fdt = "fdt-SEQ";
-#endif
-				};
-			};
-		};
-	};
-};
diff --git a/board/AndesTech/ae350/Kconfig b/board/AndesTech/ae350/Kconfig
index 8b5a2bda99..f067afcc6e 100644
--- a/board/AndesTech/ae350/Kconfig
+++ b/board/AndesTech/ae350/Kconfig
@@ -19,11 +19,9 @@ config ENV_OFFSET
 	default 0x140000 if ENV_IS_IN_SPI_FLASH
 
 config SPL_TEXT_BASE
-	default 0x02000000 if (SPL_LOAD_FIT_PAYLOAD)  && RISCV
 	default 0x800000
 
 config SPL_OPENSBI_LOAD_ADDR
-	default 0x00000000 if (SPL_LOAD_FIT_PAYLOAD)  && RISCV
 	default 0x01000000
 
 config BOARD_SPECIFIC_OPTIONS # dummy
@@ -60,11 +58,9 @@ config ENV_OFFSET
 	default 0x140000 if ENV_IS_IN_SPI_FLASH
 
 config SPL_TEXT_BASE
-	default 0x02000000 if (SPL_LOAD_FIT_PAYLOAD)  && RISCV
 	default 0x800000
 
 config SPL_OPENSBI_LOAD_ADDR
-	default 0x00000000 if (SPL_LOAD_FIT_PAYLOAD)  && RISCV
 	default 0x01000000
 
 config BOARD_SPECIFIC_OPTIONS # dummy
