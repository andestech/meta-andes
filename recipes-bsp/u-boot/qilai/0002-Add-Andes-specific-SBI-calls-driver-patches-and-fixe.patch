diff --git a/include/cache.h b/include/cache.h
index b12fec2591..4fb96cc6fa 100644
--- a/include/cache.h
+++ b/include/cache.h
@@ -40,6 +40,14 @@ struct cache_ops {
 	 * @return 0 if OK, -ve on error
