 common/spl/spl_opensbi.c     |   1 -
 drivers/cache/cache-uclass.c |  10 ++++
 drivers/cache/cache-v5l2.c   |  50 ++++++++++++-----
 drivers/mmc/ftsdc010_mci.c   |   7 +--
 include/cache.h              |  16 ++++++
 9 files changed, 220 insertions(+), 24 deletions(-)

