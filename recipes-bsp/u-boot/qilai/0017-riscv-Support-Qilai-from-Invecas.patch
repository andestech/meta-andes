diff --git a/board/AndesTech/qilai/Kconfig b/board/AndesTech/qilai/Kconfig
index 5233e815c2..ed63394704 100644
--- a/board/AndesTech/qilai/Kconfig
+++ b/board/AndesTech/qilai/Kconfig
@@ -35,3 +35,41 @@ config BOARD_SPECIFIC_OPTIONS # dummy
 	imply OF_HAS_PRIOR_STAGE
 
 endif
+
+if TARGET_ANDES45_QILAI_INVECAS
+
+config SYS_CPU
+	default "andes45"
+
+config SYS_BOARD
+	default "qilai"
+
+config SYS_VENDOR
+	default "AndesTech"
+
+config SYS_CONFIG_NAME
+	default "andes45-qilai-invecas"
+
+config ENV_SIZE
+	default 0x2000 if ENV_IS_IN_SPI_FLASH
+
+config ENV_OFFSET
+	default 0x140000 if ENV_IS_IN_SPI_FLASH
+
+config SPL_TEXT_BASE
+	default 0x400800000
+
+config SPL_OPENSBI_LOAD_ADDR
+	default 0x400000000
+
+config BOARD_SPECIFIC_OPTIONS # dummy
+	def_bool y
+	select RISCV_NDS
+	select SUPPORT_SPL
+	select BINMAN if SPL
+	imply SMP
+	imply SPL_RAM_SUPPORT
+	imply SPL_RAM_DEVICE
+	imply OF_HAS_PRIOR_STAGE
+
+endif
